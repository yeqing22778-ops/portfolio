# ── 构建期变量（Cloudflare Pages → Settings → Variables and Secrets）
# 你的 GitHub 用户名（必填）
GITHUB_USER=yeqing22778-ops

# GitHub Token，只用「Public repositories: Read-only」权限（强烈建议填）
# 不填也能跑，但未认证限流 60 次/小时，构建容易失败
GITHUB_TOKEN=

# ── 运行期变量（私密区用，必填，否则私密区一律拒绝访问）
# 密码的 SHA-256：node scripts/hash-password.mjs "你的密码"
SITE_PASSWORD_SHA256=

# Cookie 签名密钥：node scripts/hash-password.mjs --secret
COOKIE_SECRET=

# 私密区草稿数据，JSON 字符串，例如：
# [{"title":"待做的项目","note":"先做骨架","url":""}]
# 这段内容只存在于环境变量里，不会进仓库、不会进公开页面
PRIVATE_DATA=[]
